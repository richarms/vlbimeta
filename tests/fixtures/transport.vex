VEX_rev = 1.5;
* Synthetic transport fixture, not an operational telescope configuration.
* Deliberately preserves mixed-case experiment, station and scan identifiers.
$GLOBAL;
    ref $EXPER = LabContract;
$EXPER;
    def LabContract;
        exper_name = LabContract;
    enddef;
$STATION;
    def Me;
        ref $SITE = MeerKAT;
    enddef;
$SITE;
    def MeerKAT;
        site_name = MeerKAT;
        site_ID = Me;
    enddef;
$MODE;
    def LabMode;
        ref $FREQ = LabBand : Me;
    enddef;
$FREQ;
    def LabBand;
        sample_rate = 64 Ms/sec;
    enddef;
$SOURCE;
    def LabSource;
        source_name = LabSource;
        ra = 12h00m00s;
        dec = -30d00'00";
        ref_coord_frame = J2000;
    enddef;
$SCHED;
    scan No0001;
        start = 2026y253d12h00m00s;
        mode = LabMode;
        source = LabSource;
        station = Me : 0.25 sec : 3.5 sec : : : : 1;
    endscan;
    scan No0002;
        start = 2026y253d12h00m04s;
        mode = LabMode;
        source = LabSource;
        station = Me : 0 sec : 2 sec : : : : 1;
    endscan;
